
# Which LLM provider is active: "anthropic", "gemini", or "groq". See
# app/llm/client.py's get_llm_client(). Only the active provider's key below
# actually needs a value. Note: POST /summarize/stream returns 501 under
# LLM_PROVIDER=groq only -- Groq's API can't combine structured output with
# streaming. All endpoints work on cerebras, gemini and anthropic.
LLM_PROVIDER=cerebras

# Anthropic API key - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Gemini API key (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash/-flash-lite 404 for newly created API keys (a live Google
# rollout restriction) -- gemini-3.6-flash is confirmed free-tier eligible and
# working as of 2026-07-27. Free tier is only 20 requests/day/model/project,
# also discovered live -- too tight for regular dev use, see CLAUDE.md.
GEMINI_MODEL=gemini-3.6-flash

# Groq API key (free tier, 1,000 requests/day BUT only 8,000 tokens/minute -- a full
# 10-K Item 1A section (~12-13K tokens) is rejected with a 413, so Groq only works
# for small inputs) - https://console.groq.com/keys
GROQ_API_KEY=
# Only openai/gpt-oss-20b and openai/gpt-oss-120b support strict-mode
# structured outputs on Groq -- NOT llama-3.3-70b-versatile, despite that
# being the model usually cited for Groq's free tier (confirmed via
# console.groq.com/docs/structured-outputs).
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras API key (free tier: 65K context, 30K tokens/min, 1M tokens/day, but only
# 5 requests/min) - https://cloud.cerebras.ai  (LLM_PROVIDER=cerebras)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=60

# SEC EDGAR requires a descriptive User-Agent identifying you/your app, per
# their fair-access policy: https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="prustycolab@gmail.com"

APP_ENV=local
    