
# Anthropic API key - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model id (swappable; see app/config.py). Default: claude-sonnet-5
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=60

# SEC EDGAR requires a descriptive User-Agent identifying you/your app, per
# their fair-access policy: https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="prustycolab@gmail.com"

APP_ENV=local
    